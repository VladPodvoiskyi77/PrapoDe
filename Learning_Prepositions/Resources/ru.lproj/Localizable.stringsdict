<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>result.correct_answers</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@answers@</string>
		<key>answers</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>правильный ответ</string>
			<key>few</key>
			<string>правильных ответа</string>
			<key>many</key>
			<string>правильных ответов</string>
			<key>other</key>
			<string>правильных ответов</string>
		</dict>
	</dict>
	<key>quizReview.mistakes_count_formatted</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@mistakes@</string>
		<key>mistakes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d ошибка</string>
			<key>few</key>
			<string>%d ошибки</string>
			<key>many</key>
			<string>%d ошибок</string>
			<key>other</key>
			<string>%d ошибок</string>
		</dict>
	</dict>
	<key>quizReview.correct_count_formatted</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@correct@</string>
		<key>correct</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d верный</string>
			<key>few</key>
			<string>%d верных</string>
			<key>many</key>
			<string>%d верных</string>
			<key>other</key>
			<string>%d верных</string>
		</dict>
	</dict>
</dict>
</plist>
