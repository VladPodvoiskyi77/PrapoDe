//================================================ About screen =================================================
"about.title" = "Über die App";
"about.intro" = "Erscheint dir die deutsche Grammatik schwierig und die Rektion der Verben wie ein Albtraum? PrapoDe ist dein Taschentrainer, der das sture Auswendiglernen von Tabellen in ein spannendes Spiel verwandelt.";
"about.why.title" = "Warum PrapoDE?";
"about.feature1.title" = "1. Alle Niveaus";
"about.feature1.text" = "Von A1 bis C1 – lernen Sie genau das, was Sie für Ihre aktuelle Stufe brauchen.";

"about.feature_training.title" = "2. Trainingsmodus";
"about.feature_training.text" = "Schauen Sie sich die komplette Wortliste mit Übersetzungen an, bevor Sie die Tests starten.";

"about.feature_quiz.title" = "3. Klassisches Quiz";
"about.feature_quiz.text" = "Wählen Sie in aller Ruhe die richtige Präposition aus den vorgegebenen Optionen.";

"about.feature2.title" = "4. Sprint-Modus";
"about.feature2.text" = "Testen Sie Ihre Reaktion: Erreichen Sie so viele richtige Antworten wie möglich in 60 Sekunden.";

"about.feature_writing.title" = "5. Schreibmodus";
"about.feature_writing.text" = "Geben Sie Präpositionen manuell ein – der effektivste Weg, um sie im Gedächtnis zu verankern.";

"about.feature_analysis.title" = "6. Fehleranalyse";
"about.feature_analysis.text" = "Analysieren Sie Ihre Fehler direkt nach dem Test, um aus ihnen zu lernen.";

"about.feature3.title" = "7. 5-Punkte-System";
"about.feature3.text" = "Ein Wort gilt erst nach 5 korrekten Antworten in Folge als dauerhaft gelernt.";

"about.feature6.title" = "8. Intelligentes Widget";
"about.feature6.text" = "Lernen Sie passiv direkt auf Ihrem Homescreen, ohne die App öffnen zu müssen.";

"about.feature5.title" = "9. Globales Ranking";
"about.feature5.text" = "Vergleichen Sie Ihren Fortschritt mit Deutschlernern aus der ganzen Welt.";

"about.feature4.title" = "10. Sichtbarer Fortschritt";
"about.feature4.text" = "Verfolgen Sie Ihr Wachstum durch detaillierte Statistiken und Grafiken.";
"about.outro" = "Hör auf, Präpositionen zu raten. Fang an, sicher zu sprechen!";
